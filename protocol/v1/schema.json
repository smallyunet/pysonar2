{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smallyunet/pysonar2/protocol/v1/schema.json",
  "title": "PySonar2 protocol v1",
  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["schemaVersion", "cliVersion", "command"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "cliVersion": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "id": { "type": "string" }
      }
    },
    "location": {
      "type": "object",
      "required": ["file", "startLine", "startCharacter", "endLine", "endCharacter"],
      "properties": {
        "file": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 1 },
        "startCharacter": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endCharacter": { "type": "integer", "minimum": 1 },
        "snippet": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "required": ["discoveredFiles", "parsedFiles", "failedFileCount", "failedFiles", "unsupportedNodeTypes", "detectedFrameworkSemantics", "unsupportedSemanticSymbols"],
      "properties": {
        "discoveredFiles": { "type": "integer", "minimum": 0 },
        "parsedFiles": { "type": "integer", "minimum": 0 },
        "failedFileCount": { "type": "integer", "minimum": 0 },
        "failedFiles": { "type": "array", "items": { "type": "string" } },
        "unsupportedNodeTypes": { "type": "array", "items": { "type": "string" } },
        "detectedFrameworkSemantics": { "type": "array", "items": { "type": "string" } },
        "unsupportedSemanticSymbols": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "diagnostic": {
      "type": "object",
      "required": ["file", "startLine", "startCharacter", "endLine", "endCharacter", "severity", "message"],
      "properties": {
        "file": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 1 },
        "startCharacter": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endCharacter": { "type": "integer", "minimum": 1 },
        "severity": { "type": ["string", "null"] },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    },
    "rebuildMetrics": {
      "type": "object",
      "required": ["rebuildMode", "changedFiles", "affectedFiles", "analyzedFiles", "astCacheHits", "astCacheMisses", "rebuildReason"],
      "properties": {
        "rebuildMode": { "enum": ["full", "incremental", "no_change"] },
        "changedFiles": { "type": "integer", "minimum": 0 },
        "affectedFiles": { "type": "integer", "minimum": 0 },
        "analyzedFiles": { "type": "integer", "minimum": 0 },
        "astCacheHits": { "type": "integer", "minimum": 0 },
        "astCacheMisses": { "type": "integer", "minimum": 0 },
        "rebuildReason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "sessionRequest": {
      "oneOf": [
        {
          "type": "object",
          "required": ["command", "symbol"],
          "properties": {
            "id": { "type": "string" },
            "command": { "const": "plan" },
            "symbol": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              ]
            },
            "intent": { "enum": ["inspect", "change"] },
            "maxResults": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["command"],
          "properties": { "id": { "type": "string" }, "command": { "const": "refresh" } },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["command"],
          "properties": { "id": { "type": "string" }, "command": { "const": "quit" } },
          "additionalProperties": true
        }
      ]
    }
  },
  "allOf": [{ "$ref": "#/$defs/envelope" }],
  "additionalProperties": true
}
