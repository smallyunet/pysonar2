{
  "name": "pysonar2-code-intelligence",
  "displayName": "PySonar2 Type Inference",
  "description": "Whole-project Python type inference and semantic indexing powered by native Rust.",
  "icon": "images/icon.png",
  "version": "4.1.0",
  "publisher": "smallyu",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/smallyunet/pysonar2.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "python",
    "static analysis",
    "type inference",
    "semantic index",
    "code indexing",
    "language server",
    "definitions",
    "references"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onCommand:pysonar2.restartServer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pysonar2.restartServer",
        "title": "PySonar2: Reindex Workspace"
      },
      {
        "command": "pysonar2.showOutput",
        "title": "PySonar2: Show Output"
      }
    ],
    "configuration": {
      "title": "PySonar2",
      "properties": {
        "pysonar2.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional path to a development PySonar2 native language-server binary. The bundled server is used when empty."
        }
      }
    }
  },
  "scripts": {
    "build:server": "node ./scripts/build-server.mjs",
    "compile": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --sourcemap",
    "build": "npm run build:server && npm run compile",
    "check": "tsc -p . --noEmit",
    "smoke": "node ./scripts/smoke-server.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --out pysonar2-code-intelligence.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
