{
  "name": "pysonar2-code-intelligence",
  "displayName": "PySonar2 Code Intelligence",
  "description": "Local whole-project Python semantics for change inspection, definitions, references, inferred types, and diagnostics.",
  "icon": "images/icon.png",
  "version": "0.2.5",
  "publisher": "smallyu",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/smallyunet/pysonar2.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "python",
    "static analysis",
    "type inference",
    "change impact",
    "refactoring",
    "legacy python",
    "language server",
    "code intelligence"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onCommand:pysonar2.restartServer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pysonar2.restartServer",
        "title": "PySonar2: Reindex Workspace"
      },
      {
        "command": "pysonar2.showOutput",
        "title": "PySonar2: Show Output"
      }
    ],
    "configuration": {
      "title": "PySonar2",
      "properties": {
        "pysonar2.java.command": {
          "type": "string",
          "default": "java",
          "scope": "machine-overridable",
          "description": "Java 11+ executable used to start the bundled PySonar2 language server."
        },
        "pysonar2.java.maxHeapMb": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "machine-overridable",
          "description": "Optional maximum Java heap in MB. Zero keeps the JVM default; increase this only after narrowing the indexed workspace."
        },
        "pysonar2.python.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional Python 3.10+ executable. When empty, PySonar2 uses python3 from PATH."
        },
        "pysonar2.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional path to a development PySonar2 JAR. The bundled server is used when empty."
        },
        "pysonar2.analysis.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.venv/**",
            "**/venv/**",
            "**/node_modules/**",
            "**/build/**",
            "**/dist/**",
            "**/target/**"
          ],
          "scope": "resource",
          "description": "Workspace-relative glob patterns excluded from PySonar2 analysis."
        },
        "pysonar2.diagnostics.mode": {
          "type": "string",
          "enum": [
            "conservative",
            "all",
            "off"
          ],
          "default": "conservative",
          "scope": "resource",
          "description": "Controls semantic diagnostics. Conservative shows only high-confidence findings, all exposes analyzer warnings, and off disables diagnostics while keeping navigation and hovers."
        },
        "pysonar2.diagnostics.maxPerFile": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "scope": "resource",
          "description": "Maximum PySonar2 diagnostics published per file. Zero disables diagnostics."
        }
      }
    }
  },
  "scripts": {
    "build:server": "node ./scripts/build-server.mjs",
    "compile": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --sourcemap",
    "build": "npm run build:server && npm run compile",
    "check": "tsc -p . --noEmit",
    "smoke": "node ./scripts/smoke-server.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --out pysonar2-code-intelligence.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
