{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run PySonar2 Extension Demo",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/../../demo_project"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "build"
    }
  ]
}
