#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${PYSONAR_BIN:-}" ]; then
  engine=$PYSONAR_BIN
elif [ -x "$script_dir/../lib/pysonar" ]; then
  engine=$script_dir/../lib/pysonar
elif [ -x "$script_dir/../target/release/pysonar" ]; then
  engine=$script_dir/../target/release/pysonar
elif [ -x "$script_dir/../target/debug/pysonar" ]; then
  engine=$script_dir/../target/debug/pysonar
else
  echo "PySonar2 native binary not found. Build with 'cargo build --release' or set PYSONAR_BIN." >&2
  exit 127
fi
exec "$engine" "$@"
